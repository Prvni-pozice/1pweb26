# Kontaktní formulář → Resend API (nastavit ve Vercelu, NE commitovat skutečné hodnoty)
RESEND_API_KEY=__nastavit_ve_Vercelu__
MAIL_FROM=První pozice <podpora@prvni-pozice.com>
MAIL_TO=zdenek@prvni-pozice.com

# Měření poptávek — dashboard, týdenní report a úložiště (viz docs/MERENI-A-REPORT.md)
STATS_PASSWORD=__nastavit_ve_Vercelu__
REPORT_SECRET=__nastavit_ve_Vercelu__
# Upstash Redis přes REST API; místo KV_* fungují i UPSTASH_REDIS_REST_URL / _TOKEN
KV_REST_API_URL=__nastavit_ve_Vercelu__
KV_REST_API_TOKEN=__nastavit_ve_Vercelu__
